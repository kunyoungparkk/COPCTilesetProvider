{
  "name": "copc-tileset-provider",
  "version": "0.1.1",
  "description": "Stream static COPC point clouds into CesiumJS with no pre-tiling step.",
  "keywords": [
    "copc",
    "point-cloud",
    "lidar",
    "cesium",
    "cesiumjs",
    "3d-tiles",
    "laz",
    "las",
    "streaming",
    "gis"
  ],
  "homepage": "https://github.com/kunyoungparkk/COPCTilesetProvider#readme",
  "bugs": {
    "url": "https://github.com/kunyoungparkk/COPCTilesetProvider/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunyoungparkk/COPCTilesetProvider.git"
  },
  "license": "MIT",
  "author": "Kunyoung Park",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/types/worker/browser.d.ts",
      "import": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rm -rf dist && rolldown -c rolldown.config.mjs && tsc -p tsconfig.build.json && node build/assert-bundles.mjs dist",
    "smoke": "npm run build && node smoke/run.mjs"
  },
  "dependencies": {
    "copc": "^0.0.9",
    "laz-perf": "^0.0.7",
    "proj4": "^2.21.0"
  },
  "peerDependencies": {
    "cesium": ">=1.142.0 <1.145.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "rolldown": "^1.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
